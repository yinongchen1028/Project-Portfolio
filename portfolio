<style>
  :root {
    color-scheme: light;
    --paper: #f4f5f2;
    --sheet: #ffffff;
    --ink: #1c1f26;
    --ink-soft: #4b515c;
    --rule: #cfd6db;
    --lead: #c8372d;      /* servo-lead red: used for links, marks and focus only */
    --head: "Barlow Condensed", "Arial Narrow", "Helvetica Neue", sans-serif;
    --body: "Source Serif 4", Georgia, "Times New Roman", serif;
    --gap: clamp(1rem, 2.4vw, 1.75rem);
    --wrap: 72rem;
  }

  *, *::before, *::after { box-sizing: border-box; }
  html { scroll-behavior: smooth; scroll-padding-top: 1rem; }
  body {
    margin: 0;
    background: var(--paper);
    color: var(--ink);
    font: 400 1.0625rem/1.65 var(--body);
    -webkit-font-smoothing: antialiased;
  }
  img { display: block; max-width: 100%; height: auto; }
  a { color: var(--ink); text-decoration-color: var(--lead); text-decoration-thickness: 2px; text-underline-offset: 3px; }
  a:hover { color: var(--lead); }
  :focus-visible { outline: 3px solid var(--lead); outline-offset: 3px; }

  .wrap { width: min(100% - 2rem, var(--wrap)); margin-inline: auto; }

  /* ---------- top bar ---------- */
  .bar { border-bottom: 1px solid var(--rule); background: var(--paper); }
  .bar .wrap { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: .5rem 1.5rem; padding-block: 1rem; }
  .brand { font: 700 1.5rem/1 var(--head); letter-spacing: .01em; text-decoration: none; }
  .bar nav { display: flex; flex-wrap: wrap; gap: .25rem 1.25rem; font: 500 1.0625rem/1.2 var(--head); }
  .bar nav a { text-decoration: none; padding-block: .25rem; border-bottom: 2px solid transparent; }
  .bar nav a:hover { border-bottom-color: var(--lead); color: var(--ink); }

  /* ---------- hero ---------- */
  .hero { padding-block: clamp(2rem, 6vw, 4.5rem); }
  .hero .wrap { display: grid; gap: clamp(1.5rem, 4vw, 3.5rem); grid-template-columns: 1fr; align-items: center; }
  @media (min-width: 52rem) { .hero .wrap { grid-template-columns: 1.25fr 1fr; } }
  .hero h1 { font: 700 clamp(2.75rem, 7vw, 5rem)/.98 var(--head); letter-spacing: -.005em; margin: 0 0 1.25rem; max-width: 13ch; }
  .hero .lede { font-size: 1.25rem; line-height: 1.55; max-width: 34em; margin: 0 0 2rem; color: var(--ink-soft); }

  .index { margin: 0; padding: 0; list-style: none; border-top: 2px solid var(--ink); max-width: 36rem; }
  .index li { border-bottom: 1px solid var(--rule); }
  .index a { display: flex; justify-content: space-between; gap: 1rem; align-items: baseline; padding: .6rem .1rem; text-decoration: none; }
  .index a:hover { color: var(--ink); background: #fff; }
  .index .t { font: 600 1.25rem/1.2 var(--head); white-space: nowrap; }
  .index .d { font-size: .95rem; color: var(--ink-soft); text-align: right; line-height: 1.35; }
  @media (max-width: 34rem) { .index a { flex-direction: column; gap: .1rem; } .index .d { text-align: left; } }

  .hero-fig { margin: 0; justify-self: center; width: min(100%, 26rem); }
  .hero-fig .frame { background: var(--sheet); border: 1px solid var(--ink); padding: .6rem; }
  .hero-fig img { width: 100%; aspect-ratio: 3 / 4; object-fit: cover; }
  /* dimension line: caption sits between two end ticks, like a drawing callout */
  .dim { position: relative; margin-top: 1rem; padding-top: .55rem; text-align: center; font: 500 1rem/1.2 var(--head); color: var(--ink-soft); }
  .dim::before { content: ""; position: absolute; inset: 0 0 auto 0; height: 9px; border-left: 1.5px solid var(--ink); border-right: 1.5px solid var(--ink); background: linear-gradient(var(--ink), var(--ink)) center 4px / 100% 1.5px no-repeat; }
  .dim span { display: inline-block; background: var(--paper); padding-inline: .6rem; position: relative; top: -.1rem; }

  /* ---------- project sheets ---------- */
  main { padding-bottom: 3rem; }
  .sheet { background: var(--sheet); border: 1.5px solid var(--ink); margin-block: clamp(2rem, 5vw, 3.5rem); }
  .sheet > header { padding: clamp(1.25rem, 3vw, 2rem) clamp(1.25rem, 3vw, 2.25rem) 0; }
  .sheet h2 { font: 700 clamp(2rem, 4.5vw, 3rem)/1 var(--head); margin: 0 0 .6rem; }
  .sheet header p { margin: 0; max-width: 40em; color: var(--ink-soft); font-size: 1.125rem; }

  .row { display: grid; gap: var(--gap); grid-template-columns: 1fr; padding: clamp(1.25rem, 3vw, 2.25rem); }
  .row + .row { border-top: 1px solid var(--rule); }
  @media (min-width: 52rem) {
    .row { grid-template-columns: 5fr 7fr; align-items: start; }
    .row.stack { grid-template-columns: 1fr; }
  }
  .row h3 { font: 600 1.5rem/1.1 var(--head); margin: 0 0 .6rem; }
  .row p { margin: 0 0 1rem; }
  .row p:last-child { margin-bottom: 0; }
  .row ul { margin: 0; padding-left: 1.15rem; }
  .row li { margin-bottom: .45rem; padding-left: .2rem; }
  .row li::marker { color: var(--lead); }

  .exhaust { display: grid; grid-template-columns: 1fr 7.5rem; gap: 1rem; align-items: start; }
  .exhaust figure { margin: 0; }
  .row.stack .text { display: grid; gap: var(--gap); }
  @media (min-width: 52rem) { .row.stack .text { grid-template-columns: 1fr 1fr; } }

  /* galleries */
  .gallery { display: grid; gap: var(--gap); grid-template-columns: repeat(6, 1fr); align-items: start; }
  .gallery figure { margin: 0; grid-column: span 3; }
  .gallery .s2 { grid-column: span 2; }
  .gallery .s4 { grid-column: span 4; }
  .gallery .s6 { grid-column: span 6; }
  @media (max-width: 40rem) {
    .gallery figure, .gallery .s2 { grid-column: span 3; }
    .gallery .s4, .gallery .s6 { grid-column: span 6; }
  }
  .zoom { display: block; width: 100%; padding: 0; border: 1px solid var(--rule); background: var(--paper); cursor: zoom-in; font: inherit; }
  .zoom:hover { border-color: var(--ink); }
  .zoom img { width: 100%; }
  figcaption { font: 500 1rem/1.25 var(--head); color: var(--ink-soft); margin-top: .4rem; }
  .diagram .zoom { background: #fff; }
  .logo-tile .zoom { background: #fff; padding: 1.5rem; }

  /* title block, borrowed from the corner of a technical drawing */
  .titleblock { margin: 0; display: grid; grid-template-columns: repeat(2, 1fr); border-top: 1.5px solid var(--ink); }
  @media (min-width: 52rem) { .titleblock { grid-template-columns: 1.1fr 1.4fr 1.6fr .8fr; } }
  .titleblock > div { padding: .8rem 1rem 1rem; border-right: 1px solid var(--rule); border-bottom: 1px solid var(--rule); }
  .titleblock > div:nth-child(2n) { border-right: 0; }
  @media (min-width: 52rem) {
    .titleblock > div { border-bottom: 0; }
    .titleblock > div:nth-child(2n) { border-right: 1px solid var(--rule); }
    .titleblock > div:last-child { border-right: 0; }
  }
  .titleblock dt { font: 500 .9rem/1.2 var(--head); letter-spacing: .02em; color: var(--ink-soft); margin-bottom: .2rem; }
  .titleblock dd { margin: 0; font-size: 1rem; line-height: 1.4; }

  /* ---------- footer ---------- */
  footer { border-top: 2px solid var(--ink); padding-block: 2.5rem 3.5rem; }
  footer .wrap { display: flex; flex-wrap: wrap; gap: 1.5rem 3rem; justify-content: space-between; align-items: end; }
  footer h2 { font: 700 2.25rem/1 var(--head); margin: 0 0 .5rem; }
  footer p { margin: 0; color: var(--ink-soft); }
  footer ul { list-style: none; margin: 0; padding: 0; display: flex; gap: 1.5rem; font: 600 1.25rem/1 var(--head); }

  /* ---------- lightbox ---------- */
  dialog { border: 1.5px solid var(--ink); padding: 0; max-width: min(92vw, 70rem); max-height: 92vh; background: var(--sheet); overflow: auto; }
  dialog::backdrop { background: rgba(20, 22, 28, .78); }
  dialog img { max-height: 78vh; width: auto; margin-inline: auto; }
  dialog .cap { display: flex; justify-content: space-between; align-items: center; gap: 1rem; padding: .7rem 1rem; border-top: 1px solid var(--rule); font: 500 1.0625rem/1.3 var(--head); }
  dialog button { font: 600 1rem/1 var(--head); padding: .5rem .9rem; border: 1.5px solid var(--ink); background: var(--sheet); color: var(--ink); cursor: pointer; }
  dialog button:hover { background: var(--ink); color: #fff; }

  @media (prefers-reduced-motion: reduce) { html { scroll-behavior: auto; } }
  @media print { .bar nav, dialog { display: none; } .sheet { break-inside: avoid; } }
</style>
</head>
